{
  "expo": {
    "name": "Gemini AI Companion",
    "slug": "gemini-ai-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lumina-icon.png",
    "scheme": "gemini-ai-companion",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/lumina-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.lumina.aicompanion",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/lumina-icon.png",
        "backgroundColor": "#14264b"
      }
    },
    "web": {
      "favicon": "./assets/images/lumina-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
